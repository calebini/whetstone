{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-review-decision-request-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-review-decision-request-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "base_draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_map_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_contract_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "source_feedback_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "proposed_change": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "const": [
        "defer",
        "new_authorized_transaction"
      ]
    },
    "status": {
      "const": "pending"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision_[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "base_draft_hash",
    "authority_map_hash",
    "scope_contract_hash",
    "feedback",
    "finding_id",
    "source_feedback_id",
    "question",
    "proposed_change",
    "options",
    "status",
    "decision_id"
  ],
  "x-whetstone": {
    "producer": "orchestrator",
    "consumer": "vnext-runtime",
    "version": "vnext-review-decision-request-v1",
    "canonical_json": "whetstone-canonical-json-v1",
    "migration": "none; separate from frozen vnext-contracts-1"
  }
}
