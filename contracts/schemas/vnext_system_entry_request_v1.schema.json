{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-system-entry-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "entry_request",
    "input_hash",
    "mutation_plan_hash",
    "base_pointer"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-system-entry-request-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{64}$"
    },
    "entry_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mutation_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "x-whetstone": {
    "version": "vnext-system-entry-request-v1",
    "producer": "orchestrator",
    "consumer": "version-entry",
    "migration": "none"
  }
}
