{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whetstone Contract Suite Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "canonical_json_version",
    "schemas",
    "algorithms",
    "fixtures",
    "suite_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "whetstone-contract-suite-manifest-v1"
    },
    "suite_version": {
      "type": "string",
      "minLength": 1
    },
    "canonical_json_version": {
      "const": "whetstone-canonical-json-v1"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "whetstone_contract_suite_manifest_v1.schema.json#/$defs/versioned_file"
      }
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "whetstone_contract_suite_manifest_v1.schema.json#/$defs/versioned_file"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "whetstone_contract_suite_manifest_v1.schema.json#/$defs/fixture"
      }
    },
    "suite_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "versioned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "path",
        "sha256",
        "expected_result"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_result": {
          "enum": [
            "pass",
            "reject"
          ]
        }
      }
    }
  }
}
