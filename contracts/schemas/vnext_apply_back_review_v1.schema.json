{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-apply-back-review-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "current_verified_pointer",
    "verified_draft",
    "verified_map",
    "closeout",
    "source",
    "changed"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-apply-back-review-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "current_verified_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verified_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verified_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_hash",
        "parent_identity",
        "file_identity",
        "metadata",
        "mtime_ns",
        "ctime_ns"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expected_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_identity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "file_identity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "uid",
            "gid",
            "provenance"
          ],
          "properties": {
            "mode": {
              "type": "integer",
              "minimum": 0
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "gid": {
              "type": "integer",
              "minimum": 0
            },
            "provenance": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{2})*$"
                }
              ]
            }
          }
        },
        "mtime_ns": {
          "type": "integer",
          "minimum": 0
        },
        "ctime_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "changed": {
      "type": "boolean"
    }
  },
  "x-whetstone": {
    "version": "vnext-apply-back-review-v1",
    "producer": "orchestrator",
    "consumer": "internal-verified-apply-back",
    "tests": [
      "tests/test_vnext_apply_back.py"
    ]
  }
}
