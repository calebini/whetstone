{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "round_number",
    "base_pointer",
    "review_configuration",
    "sources",
    "feedback",
    "advice",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-vertical-merge-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "round_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_pointer": {
      "$ref": "#/$defs/reference"
    },
    "review_configuration": {
      "$ref": "#/$defs/reference"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_number",
          "profile",
          "receipt",
          "feedback",
          "advice"
        ],
        "properties": {
          "round_number": {
            "type": "integer",
            "minimum": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "receipt": {
            "$ref": "#/$defs/reference"
          },
          "feedback": {
            "$ref": "#/$defs/reference"
          },
          "advice": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "feedback": {
      "$ref": "#/$defs/reference"
    },
    "advice": {
      "$ref": "#/$defs/reference"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feedback_id",
          "source_profile",
          "original_feedback_id",
          "source_round"
        ],
        "properties": {
          "feedback_id": {
            "type": "string",
            "minLength": 1
          },
          "source_profile": {
            "type": "string",
            "minLength": 1
          },
          "original_feedback_id": {
            "type": "string",
            "minLength": 1
          },
          "source_round": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-vertical-merge-v1",
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
