{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-admission-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-admission-v1"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_descriptor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "hash"
          ]
        },
        "review_configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "hash"
          ]
        }
      },
      "required": [
        "job_descriptor",
        "review_configuration"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "seed_pointer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "selection",
    "job_id",
    "seed_pointer",
    "created_at"
  ],
  "x-whetstone": {
    "producer": "orchestrator",
    "consumer": "vnext-runtime",
    "version": "vnext-admission-v1",
    "canonical_json": "whetstone-canonical-json-v1",
    "migration": "none; separate from frozen vnext-contracts-1"
  }
}
