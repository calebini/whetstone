{
  "title": "Whetstone Proposal Review And Classification Advice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback",
    "classifications"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "vnext-review-response-v1"
      ],
      "type": "string"
    },
    "feedback": {
      "title": "Whetstone Reviewer Feedback",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_number",
        "profile",
        "reviewer",
        "draft_hash",
        "feedback"
      ],
      "properties": {
        "round_number": {
          "type": "integer"
        },
        "profile": {
          "type": "string"
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "model"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        },
        "draft_hash": {
          "type": "string"
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feedback_id",
              "issue_id",
              "issue_fingerprint",
              "issue_type",
              "affected_sections",
              "baseline_severity",
              "authority_impact",
              "determinism_impact",
              "rubric_impact",
              "normalized_severity",
              "invariant_violated",
              "claim",
              "evidence",
              "recommended_change",
              "in_scope",
              "severity_rationale",
              "oscillation_key"
            ],
            "properties": {
              "feedback_id": {
                "type": "string"
              },
              "issue_id": {
                "type": "string"
              },
              "issue_fingerprint": {
                "type": "string"
              },
              "issue_type": {
                "type": "string"
              },
              "affected_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "baseline_severity": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "nit"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "authority_impact": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "nit"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "determinism_impact": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "nit"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rubric_impact": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "nit"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "normalized_severity": {
                "type": "string",
                "enum": [
                  "blocker",
                  "major",
                  "minor",
                  "nit"
                ]
              },
              "invariant_violated": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "claim": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "recommended_change": {
                "type": "string"
              },
              "in_scope": {
                "type": "boolean"
              },
              "severity_rationale": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "oscillation_key": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "section_id",
                      "concern_type",
                      "direction",
                      "scope",
                      "fingerprint",
                      "opposition_key"
                    ],
                    "properties": {
                      "section_id": {
                        "type": "string"
                      },
                      "concern_type": {
                        "type": "string",
                        "enum": [
                          "clarity_gap",
                          "completeness_gap",
                          "consistency_violation",
                          "determinism_violation",
                          "authority_violation",
                          "scope_violation",
                          "redundancy",
                          "precision_gap"
                        ]
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "add",
                          "remove",
                          "modify",
                          "clarify",
                          "constrain",
                          "relax"
                        ]
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "local",
                          "structural"
                        ]
                      },
                      "fingerprint": {
                        "type": "string"
                      },
                      "opposition_key": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "section_id",
                      "concern_type",
                      "direction",
                      "scope"
                    ],
                    "properties": {
                      "section_id": {
                        "type": "string"
                      },
                      "concern_type": {
                        "type": "string",
                        "enum": [
                          "clarity_gap",
                          "completeness_gap",
                          "consistency_violation",
                          "determinism_violation",
                          "authority_violation",
                          "scope_violation",
                          "redundancy",
                          "precision_gap"
                        ]
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "add",
                          "remove",
                          "modify",
                          "clarify",
                          "constrain",
                          "relax"
                        ]
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "local",
                          "structural"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feedback_id",
          "classification",
          "authority_scope_ids",
          "source_authority_binding_ids",
          "scope_surface_ids",
          "compatibility_change",
          "requested_effects"
        ],
        "properties": {
          "feedback_id": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "editor_fixable",
              "operator_decision_required",
              "authority_conflict",
              "scope_change",
              "deferable"
            ],
            "type": "string"
          },
          "authority_scope_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_authority_binding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_surface_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compatibility_change": {
            "enum": [
              "none",
              "introduce",
              "remove"
            ],
            "type": "string"
          },
          "requested_effects": {
            "type": "array",
            "items": {
              "enum": [
                "none",
                "clarification",
                "add",
                "remove",
                "strengthen",
                "weaken",
                "authority_change",
                "scope_change"
              ],
              "type": "string"
            }
          }
        }
      }
    }
  }
}
