{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-operator-options-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-operator-options-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "round_number": {
      "type": "integer",
      "minimum": 1
    },
    "review_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "$ref": "vnext_mutation_decision_request_v2.schema.json#/properties/options"
          }
        },
        "required": [
          "finding_id",
          "options"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "round_number",
    "review_result",
    "choices"
  ]
}
