{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "patch-set-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "transaction_id",
    "proposal_id",
    "base_draft_hash",
    "mutation_plan_hash",
    "editor",
    "operations",
    "declined_findings",
    "editor_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "patch-set-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txn_[0-9a-f]{64}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^pro_[0-9a-f]{64}$"
    },
    "base_draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mutation_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "patch_operation_v1.schema.json"
      },
      "uniqueItems": true
    },
    "declined_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "source_feedback_ids",
          "decline_reason",
          "rationale"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "source_feedback_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "decline_reason": {
            "enum": [
              "architectural_conflict",
              "ambiguous",
              "out_of_scope",
              "deferred_to_later_round"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "editor_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressed_finding_ids",
        "normative_change_summary"
      ],
      "properties": {
        "addressed_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "normative_change_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "x-whetstone": {
    "version": "patch-set-v1",
    "producer": "orchestrator",
    "consumer": "offline-contract-validator",
    "canonical_json": "whetstone-canonical-json-v1",
    "migration": "none; new version required for changed bytes or semantics",
    "identity_algorithm": "vnext-identity-v1",
    "ownership": "All fields orchestrator-owned unless explicitly marked client-proposed by the identity/ownership contract.",
    "identities": [
      {
        "field": "proposal_id",
        "prefix": "pro",
        "domain": "whetstone-proposal-id-v1",
        "ordered_arguments": [
          "complete patch with proposal_id=null"
        ],
        "collision_role": "pro"
      }
    ]
  }
}
