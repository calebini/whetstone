{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "job_id",
    "transaction_id",
    "candidate_id",
    "semantic_verifier_policy_version",
    "context_hash",
    "creation_ref",
    "authority_map_hash",
    "verifier_response_hash",
    "verifier",
    "field_path",
    "resolution_scope",
    "choice"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-semantic-authority-request-v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^dec_[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txn_[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^can_[0-9a-f]{64}$"
    },
    "semantic_verifier_policy_version": {
      "const": "semantic-policy-v2"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "creation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authority_map_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier_response_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field_path": {
      "const": "authority_compliance"
    },
    "resolution_scope": {
      "const": "new_transaction_only_no_authority_change"
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "authority_scope",
        "alternatives"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "authority_scope": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority_binding_id",
              "interpretation",
              "evidence"
            ],
            "properties": {
              "authority_binding_id": {
                "type": "string",
                "pattern": "^bind_[0-9a-f]{64}$"
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "byte_start",
                  "byte_end",
                  "content_hash",
                  "text"
                ],
                "properties": {
                  "byte_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "byte_end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "minItems": 2
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-semantic-authority-request-v1",
  "x-whetstone": {
    "version": "vnext-semantic-authority-request-v1",
    "producer": "orchestrator",
    "consumer": "unactivated-semantic-protocol",
    "canonical_json": "whetstone-canonical-json-v1",
    "migration": "none; new version required for changed bytes or semantics"
  }
}
