{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext_review_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "input_hash",
    "feedback",
    "advice",
    "classification_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-review-result-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{64}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "classification_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
