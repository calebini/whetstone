{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-operator-response-input-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-operator-response-input-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "round_number": {
      "type": "integer",
      "minimum": 1
    },
    "review_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "hash"
            ]
          },
          "selected_option_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "decided_by": {
            "type": "string",
            "minLength": 1
          },
          "decided_at": {
            "$ref": "operator_decision_response_v1.schema.json#/properties/decided_at"
          }
        },
        "required": [
          "request",
          "selected_option_id",
          "rationale",
          "decided_by",
          "decided_at"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "round_number",
    "review_result",
    "selections"
  ]
}
