{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "result",
    "base_pointer",
    "accepted_passes",
    "profiles",
    "findings",
    "evidence",
    "next_gate",
    "candidate_authorized",
    "next_review_authorized",
    "phase_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-phase2-consumption-v1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "base_pointer": {
      "type": "object"
    },
    "accepted_passes": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_index",
          "profile",
          "clean",
          "rounds_used",
          "round_budget",
          "exhausted",
          "residual_status"
        ],
        "properties": {
          "step_index": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "profile": {
            "enum": [
              "convergence_strict_check",
              "adversarial"
            ]
          },
          "clean": {
            "type": "boolean"
          },
          "rounds_used": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "round_budget": {
            "type": "integer",
            "minimum": 1
          },
          "exhausted": {
            "type": "boolean"
          },
          "residual_status": {
            "enum": [
              null,
              "exhausted_with_residuals"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "source_feedback_ids",
          "classification",
          "target_section_ids"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "source_feedback_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "classification": {
            "enum": [
              "deferable",
              "operator_decision_required",
              "scope_change",
              "authority_conflict"
            ]
          },
          "target_section_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "object"
    },
    "next_gate": {
      "enum": [
        "finding_admission",
        "subsequent_request_not_implemented"
      ]
    },
    "candidate_authorized": {
      "const": false
    },
    "next_review_authorized": {
      "const": false
    },
    "phase_complete": {
      "const": false
    }
  }
}
