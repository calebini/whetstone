{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-proposal-request-invocation-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-proposal-request-invocation-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{64}$"
    },
    "attempt": {
      "enum": [
        1,
        2
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport": {
      "$ref": "vnext_proposal_request_transport_v1.schema.json"
    },
    "reason": {
      "enum": [
        "initial",
        "shape_retry",
        "technical_continuation"
      ]
    },
    "previous_outcome_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "attempt",
    "input_hash",
    "prompt_hash",
    "transport",
    "reason",
    "previous_outcome_hash"
  ]
}
