{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-operator-selection-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-operator-selection-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "round_number": {
      "type": "integer",
      "minimum": 1
    },
    "review_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "base_pointer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "decision_refs": {
      "$ref": "vnext_proposal_round_input_v1.schema.json#/properties/decision_refs"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "round_number",
    "review_result",
    "base_pointer",
    "decision_refs"
  ]
}
