{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-semantic-result-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vnext-semantic-result-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "creation_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "semantic_verification_v2.schema.json#/properties/candidate_section_identity_map_path"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "semantic_verification_v2.schema.json#/properties/candidate_section_identity_map_path"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "authority_request": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "semantic_verification_v2.schema.json#/properties/candidate_section_identity_map_path"
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "hash"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "semantic_verification_v2.schema.json#/properties/candidate_section_identity_map_path"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "reject",
        "operator_decision_required"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "context_hash",
    "creation_ref",
    "verification",
    "authority_request",
    "response",
    "verdict"
  ],
  "x-whetstone": {
    "version": "vnext-semantic-result-v1",
    "producer": "orchestrator",
    "consumer": "unactivated-semantic-request",
    "canonical_json": "whetstone-canonical-json-v1",
    "migration": "none; new version required for changed bytes or semantics"
  }
}
