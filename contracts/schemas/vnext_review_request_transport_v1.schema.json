{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vnext-review-request-transport-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "output_schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "$ref": "review_configuration_v1.schema.json#/properties/reviewer"
    }
  },
  "required": [
    "reviewer",
    "command",
    "cwd",
    "timeout_seconds",
    "output_schema_hash"
  ]
}
