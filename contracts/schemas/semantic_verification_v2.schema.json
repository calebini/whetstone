{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semantic-verification-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "transaction_id",
    "candidate_id",
    "semantic_verifier_policy_version",
    "base_draft_hash",
    "candidate_hash",
    "candidate_section_identity_map_path",
    "candidate_section_identity_map_hash",
    "patch_set_hash",
    "preservation_report_hash",
    "verifier",
    "finding_results",
    "unrelated_semantic_change",
    "lost_or_weakened_semantics",
    "authority_compliance",
    "semantic_assertions",
    "normative_change_assessment",
    "operator_decision_required",
    "uncertainty_resolutions",
    "verdict",
    "rationale",
    "context_hash",
    "creation_event_hash",
    "verifier_response_hash",
    "coverage",
    "authority_decision_request"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-verification-v2"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txn_[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^can_[0-9a-f]{64}$"
    },
    "semantic_verifier_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "base_draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_section_identity_map_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "candidate_section_identity_map_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preservation_report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "disposition",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "resolved",
              "partially_resolved",
              "not_resolved",
              "made_worse"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unrelated_semantic_change": {
      "enum": [
        "none",
        "detected",
        "uncertain"
      ]
    },
    "lost_or_weakened_semantics": {
      "enum": [
        "none",
        "detected",
        "uncertain"
      ]
    },
    "authority_compliance": {
      "enum": [
        "pass",
        "fail",
        "uncertain"
      ]
    },
    "semantic_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "result",
          "evidence"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^assert_[0-9a-f]{64}$"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "uncertain",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "normative_change_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "editor_claim",
          "verifier_assessment",
          "agrees"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^op_[0-9a-f]{64}$"
          },
          "editor_claim": {
            "type": "string",
            "minLength": 1
          },
          "verifier_assessment": {
            "type": "string",
            "minLength": 1
          },
          "agrees": {
            "type": "boolean"
          }
        }
      }
    },
    "operator_decision_required": {
      "type": "boolean"
    },
    "uncertainty_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_path",
          "policy_rule_id",
          "disposition",
          "decision_id"
        ],
        "properties": {
          "field_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
          },
          "policy_rule_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "reject",
              "operator_decision_required"
            ]
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "reject",
        "operator_decision_required"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "creation_event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier_response_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "$ref": "vnext_semantic_coverage_v1.schema.json"
    },
    "authority_decision_request": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "x-whetstone": {
    "version": "semantic-verification-v2",
    "producer": "orchestrator",
    "consumer": "unactivated-semantic-protocol",
    "canonical_json": "whetstone-canonical-json-v1",
    "migration": "none; new version required for changed bytes or semantics"
  }
}
