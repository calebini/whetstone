{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "current_verified_pointer",
    "configuration",
    "declaration_binding",
    "review_request",
    "review_result",
    "review_consumption",
    "feedback",
    "unresolved_issues",
    "source_consumptions",
    "route",
    "blocking_reasons",
    "residual_issue_ids",
    "remaining_step_budget",
    "repaired_issue_ids",
    "candidate_authorized",
    "next_review_authorized",
    "phase_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-phase2-finding-reconciliation-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "current_verified_pointer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "declaration_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "review_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "review_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "review_consumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "unresolved_issues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    },
    "source_consumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "hash"
        ]
      },
      "minItems": 1
    },
    "route": {
      "enum": [
        "closeout_eligible",
        "authority_resolution_required",
        "rubric_resolution_required",
        "source_revision_required",
        "declaration_revision_required",
        "oscillation_resolution_required",
        "profile_verification_required"
      ]
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "authority_resolution_required",
          "rubric_resolution_required",
          "source_revision_required",
          "declaration_revision_required",
          "oscillation_resolution_required",
          "profile_verification_required"
        ]
      },
      "uniqueItems": true
    },
    "residual_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^iss_[0-9a-f]{16}$"
      },
      "uniqueItems": true
    },
    "remaining_step_budget": {
      "type": "integer",
      "minimum": 0
    },
    "repaired_issue_ids": {
      "type": "array",
      "maxItems": 0
    },
    "candidate_authorized": {
      "const": false
    },
    "next_review_authorized": {
      "const": false
    },
    "phase_complete": {
      "const": false
    }
  }
}
