{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained failure before candidate packaging",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "transaction_id",
    "proposal_id",
    "round_number",
    "base_draft_hash",
    "mutation_plan_hash",
    "patch_set_hash",
    "stage",
    "error_type",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "vnext-candidate-assembly-failure-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txn_[0-9a-f]{64}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^pro_[0-9a-f]{64}$"
    },
    "round_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mutation_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "enum": [
        "assembly",
        "section_map"
      ]
    },
    "error_type": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  }
}
