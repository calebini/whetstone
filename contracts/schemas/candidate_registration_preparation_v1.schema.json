{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate-registration-preparation-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "candidate-registration-preparation-v1"},
    "creation_event": {"$ref": "candidate_creation_event_v1.schema.json"},
    "artifacts": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["path", "hash"]
      }
    }
  },
  "required": ["schema_version", "creation_event", "artifacts"]
}
